#         pathType: Prefix
#         backend:
#           service:
#             name: botmother-nginx
#             port:
#               number: 80
#   - host: www.your-domain.com
#     http:
#       paths:
#       - path: /
#         pathType: Prefix
#         backend:
#           service:
