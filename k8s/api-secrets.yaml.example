apiVersion: v1
kind: Secret
metadata:
  name: api-secrets
  namespace: botmother
type: Opaque
stringData:
  # IMPORTANT: Replace these with actual secrets in production
  # You can create this secret using:
  # kubectl create secret generic api-secrets --from-literal=DJANGO_SECRET_KEY=your-secret-key ...
  
  DJANGO_SECRET_KEY: "change-me-in-production"
  DB_PASSWORD: "change-me"
  PRIVATE_KEY: "change-me"
  PUBLIC_KEY: "change-me"
  
  # SMS service
  SMS_API_URL: "https://notify.eskiz.uz/api"
  SMS_LOGIN: "admin@gmail.com"
  SMS_PASSWORD: "change-me"
  
  # Storage
  STORAGE_ID: "change-me"
  STORAGE_KEY: "change-me"
  STORAGE_URL: "example.com"
  STORAGE_PATH: "example.com/bucket/"
  STORAGE_PROTOCOL: "http:"
  STORAGE_BUCKET_MEDIA: "media"
  STORAGE_BUCKET_STATIC: "static"
  
  # API
  API_URL: "http://api:8000"
  BOT_TOKEN: "change-me"
  TEST_BOT_TOKEN: "change-me"
  
  # Payment
  CLICK_SERVICE_ID: "change-me"
  CLICK_MERCHANT_ID: "change-me"
  CLICK_SECRET_KEY: "change-me"
  PAYTECH_API_KEY: "change-me"
  PAYME_ID: "change-me"
  PAYME_KEY: "change-me"
  
  # OTP
  OTP_DEFAULT: "1111"
  OTP_MODULE: "core.services.otp"
  OTP_SERVICE: "EskizService"
  
  # MongoDB
  MONGO_URL: "mongodb://user:password@mongodb:27017"
  
  # Hosts
  ALLOWED_HOSTS: "api,localhost,127.0.0.1"
  CSRF_TRUSTED_ORIGINS: "http://localhost:8000"
